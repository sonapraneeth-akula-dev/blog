{
  "name": "@grihasetu/blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "Grihasetu blog built with Astro + MDX (categories, tags, offline search, synced code tabs)",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4322",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --host 0.0.0.0 --port 4322",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.7.3",
    "@expressive-code/plugin-line-numbers": "^0.43.1",
    "astro": "^6.4.6",
    "astro-expressive-code": "^0.43.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "pagefind": "^1.3.0",
    "typescript": "^6.0.3"
  }
}