---
/**
 * Call-to-action link styled as a button. `icon` takes inline HTML or an emoji
 * (we don't bundle an icon set). Accepts any extra <a> attributes.
 *
 *   <LinkButton href="/blog/">Read the blog</LinkButton>
 *   <LinkButton href="https://astro.build" variant="secondary" icon="↗" iconPlacement="start">
 *     Astro docs
 *   </LinkButton>
 */
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'minimal';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: Variant;
  icon?: string;
  iconPlacement?: 'start' | 'end';
}

const {
  href,
  variant = 'primary',
  icon,
  iconPlacement = 'end',
  class: className,
  ...attrs
} = Astro.props;
---

<a href={href} class:list={['link-button', `link-button--${variant}`, className]} {...attrs}>
  {icon && iconPlacement === 'start' && <span class="link-button-icon" aria-hidden="true" set:html={icon} />}
  <span><slot /></span>
  {icon && iconPlacement === 'end' && <span class="link-button-icon" aria-hidden="true" set:html={icon} />}
</a>

<style>
  .link-button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    /* Buttons are commonly placed side by side; this keeps adjacent buttons
       (and wrapped rows) from touching without needing a wrapper element. */
    margin: 0 0.6rem 0.6rem 0;
    padding: 0.55rem 1.1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .link-button:hover { transform: translateY(-1px); }

  .link-button--primary {
    background: var(--accent);
    color: var(--accent-contrast);
  }
  .link-button--primary:hover {
    background: color-mix(in srgb, var(--accent) 88%, #000);
  }

  .link-button--secondary {
    border-color: var(--border);
    background: var(--surface);
    color: var(--text);
  }
  .link-button--secondary:hover {
    border-color: var(--border-hover);
  }

  .link-button--minimal {
    padding-inline: 0.25rem;
    color: var(--accent-text);
  }
  .link-button--minimal:hover {
    text-decoration: underline;
  }

  .link-button-icon {
    display: inline-flex;
    line-height: 0;
    font-size: 1.05em;
  }
</style>
