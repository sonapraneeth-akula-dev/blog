{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": [
      "node"
    ],
    // `baseUrl` is deprecated as of TS 6; modern TypeScript resolves the path
    // aliases below relative to this tsconfig's location, so it isn't needed.
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@layouts/*": [
        "./src/layouts/*"
      ]
    }
  }
  // `include`/`exclude` are inherited from astro/tsconfigs/strict, which already
  // globs the project (`${configDir}/**/*`), pulls in `.astro/types.d.ts` and
  // excludes `dist`. Re-declaring them here only narrowed that coverage.
}